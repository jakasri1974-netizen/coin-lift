# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coinlift_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1d

# Initial Admin Seed Configuration (Required only when manually running server/src/utils/seedAdmin.js)
ADMIN_SEED_EMAIL="admin@coinlift.com"
ADMIN_SEED_PASSWORD="your-secure-admin-password-here"
