# ==================================================
# CRYPLIFT — ENVIRONMENT VARIABLE CONFIGURATION
# ==================================================

# --------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# --------------------------------------------------
# DEVELOPMENT FRONTEND:
VITE_API_URL=http://localhost:5000/api

# PRODUCTION FRONTEND (Set in hosting provider build environment):
# VITE_API_URL=https://api.cryplift.app/api

# --------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Express & Socket.IO)
# --------------------------------------------------
# SERVER PORT
PORT=5000

# NODE ENVIRONMENT ('development' | 'production' | 'test')
NODE_ENV=development

# MONGODB CONNECTION URI
# DEVELOPMENT:
MONGODB_URI=mongodb://127.0.0.1:27017/coinlift

# PRODUCTION:
# MONGODB_URI=mongodb+srv://<prod_db_user>:<prod_db_password>@<prod_cluster>.mongodb.net/cryplift?retryWrites=true&w=majority

# JWT SECRET KEY (Use a 64+ character random string in production)
JWT_SECRET=replace_with_secure_production_jwt_secret_2026

# CORS ALLOWED ORIGINS (Comma-separated for multiple origins)
# DEVELOPMENT:
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PRODUCTION:
# CLIENT_URL=https://cryplift.app
# CORS_ORIGIN=https://cryplift.app
