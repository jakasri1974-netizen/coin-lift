# ==================================================
# CRYPLIFT — BACKEND ENVIRONMENT VARIABLES
# ==================================================

# SERVER PORT
PORT=5000

# ENVIRONMENT MODE ('development' | 'production' | 'test')
NODE_ENV=development

# DATABASE CONNECTION (MongoDB Atlas or local instance)
# DEVELOPMENT:
MONGODB_URI=mongodb://127.0.0.1:27017/coinlift

# PRODUCTION:
# MONGODB_URI=mongodb+srv://<prod_db_user>:<prod_db_password>@<prod_cluster>.mongodb.net/cryplift?retryWrites=true&w=majority

# JWT SECRET (Must be replaced with a secure secret in production)
JWT_SECRET=replace_with_secure_production_jwt_secret_2026

# FRONTEND CLIENT URL / CORS ORIGIN
# DEVELOPMENT:
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PRODUCTION:
# CLIENT_URL=https://cryplift.app
# CORS_ORIGIN=https://cryplift.app
